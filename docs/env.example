# Copy this file to `.env` in the project root:   cp docs/env.example .env

# Database connection. SQLite file by default (path is relative to prisma/schema.prisma).
# For PostgreSQL, change the provider in prisma/schema.prisma and use e.g.
# DATABASE_URL="postgresql://user:password@localhost:5432/kaino?schema=public"
DATABASE_URL="file:./kaino.db"

# Initial admin account created by `npm run db:seed`. Minimum 10 characters.
# Use a strong unique password before seeding a production database.
ADMIN_EMAIL="owner@kainoprint3d.com"
ADMIN_PASSWORD="change-me-please-123"
ADMIN_NAME="Kaino Owner"

# Directory for uploaded files (customer reference files, admin product images).
# Must be outside /public. Uploaded customer files are never executed or rendered by the server.
STORAGE_DIR="./storage"

# Public site URL, used for absolute links in quote messages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
